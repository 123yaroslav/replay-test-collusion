# Copy to .env and fill in. .env is gitignored.
# One OpenRouter key gives access to OpenAI, Anthropic, Google, DeepSeek, Qwen, Mistral, ...
# which is what the same-family vs cross-provider arms need.
OPENROUTER_API_KEY=

# Optional: any other OpenAI-compatible endpoint (vLLM, Ollama, Modal). Overrides OpenRouter.
# COLLUSION_BASE_URL=http://localhost:8000/v1
# COLLUSION_API_KEY=dummy

# Default cheap agent model and judge model (OpenRouter ids, checked 2026-10-13).
# Judge is deliberately a different family from the default agent (avoids self-preference).
COLLUSION_AGENT_MODEL=openai/gpt-6-luna
COLLUSION_JUDGE_MODEL=anthropic/claude-haiku-5.5

# Hard spend cap per process in USD (llm.py refuses further calls past it)
COLLUSION_BUDGET_USD=20
